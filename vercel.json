{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/supabase-keepalive",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/cron/editorial-audit",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/traffic-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/buffer/schedule",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/buffer/verify",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/buffer/selftest",
      "schedule": "0 7 * * *"
    }
  ]
}
