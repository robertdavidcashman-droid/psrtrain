{
  "name": "pstrain-rebuild",
  "version": "1.8.1",
  "description": "Police Station Representative training platform — psrtrain.com",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "vercel-build": "next build",
    "copy:audit": "node --experimental-strip-types scripts/audit-public-copy.ts",
    "test": "npm run copy:audit && npm run test:unit && npm run test:smoke",
    "test:unit": "vitest run",
    "test:rss-feed": "vitest run tests/unit/rss-feed.test.ts",
    "test:smoke": "node scripts/smoke-test-prod.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "test:e2e": "playwright test",
    "test:e2e:auth:prod": "playwright test tests/e2e/auth-flow.spec.ts tests/e2e/auth-smoke.spec.ts --project=chromium-desktop",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:lemon": "node scripts/test-lemon-checkout.mjs monthly && node scripts/test-lemon-checkout.mjs annual",
    "test:checkout": "vitest run tests/unit/resolve-auth-entry-redirect.test.ts && playwright test tests/e2e/pricing-checkout.spec.ts tests/e2e/reported-issues.spec.ts",
    "test:reported-issues": "playwright test tests/e2e/reported-issues.spec.ts",
    "test:user-journey": "playwright test tests/e2e/logged-out-login.spec.ts tests/e2e/monthly-plan-checkout.spec.ts tests/e2e/mobile-clicks.spec.ts tests/e2e/stephanie-account.spec.ts tests/e2e/checkout-api.spec.ts tests/e2e/reported-issues.spec.ts",
    "generate:questions-sql": "node scripts/build-all-questions-sql.mjs > scripts/_generated_questions.sql && node scripts/build-cit-scenarios-sql.mjs > scripts/_generated_cit_scenarios.sql && node scripts/resplice-all-content.mjs",
    "audit:editorial": "vitest run tests/unit/editorial-audit.test.ts",
    "audit:editorial-sourcing": "npx tsx scripts/audit/editorial-sourcing.ts",
    "audit:supabase-rls": "node scripts/audit/supabase-rls-check.mjs",
    "audit:mcq-distractors": "node scripts/audit/mcq-distractors.mjs",
    "fix:weak-distractors": "node scripts/fix-weak-distractors.mjs",
    "fix:weak-distractors-all": "node scripts/apply-weak-distractor-rewrites.mjs",
    "audit:guides-pace": "npx tsx scripts/audit/guides-publishing-pace.ts",
    "audit:guides-seo": "npx tsx scripts/audit/guides-seo.ts",
    "audit:blog-seo": "npx tsx scripts/audit/blog-seo.ts",
    "audit:guides-editorial": "npx tsx scripts/audit/editorial-sourcing.ts",
    "generate:guide-images": "node scripts/generate-guide-hero-images.mjs",
    "generate:guide-images:ai": "node scripts/generate-guide-hero-images.mjs --ai --force",
    "test:guides": "npm run generate:guide-images && vitest run tests/unit/guides-images.test.ts",
    "sync:blog-images": "node scripts/sync-blog-hero-images.mjs",
    "generate:blog-images": "node scripts/sync-blog-hero-images.mjs --ai --force",
    "test:blog": "npm run sync:blog-images && vitest run tests/unit/blog.test.ts tests/unit/blog-images.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@robertcashman/buffer-engine": "file:vendor/buffer-engine.tgz",
    "@sentry/nextjs": "^10.58.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.0",
    "lucide-react": "^0.400.0",
    "next": "^16.1.1",
    "openai": "^4.28.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.10.3",
    "resend": "^6.10.0",
    "tailwind-merge": "^2.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.7",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "node-fetch": "^2.7.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
