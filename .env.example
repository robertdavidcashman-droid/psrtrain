# Copy to `.env.local` for development. Never commit real secrets.

# --- Auth (Supabase) — required for sign-in ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only; admin tooling / webhooks / migrations (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: show Google OAuth buttons only when provider is enabled in Supabase
NEXT_PUBLIC_SUPABASE_GOOGLE_AUTH_ENABLED=false

# Canonical URL for metadata, sitemap, and OG URLs (production: https://psrtrain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Playwright: test against production without starting local dev server
# PLAYWRIGHT_BASE_URL=https://psrtrain.com

# Comma-separated emails allowed into /admin (server-side check)
ADMIN_EMAILS=

# Legacy optional gate before launch — leave unset for normal public auth
APP_ACCESS_CODE=

# Limited-time free access for all signed-in users (testing / launch promo)
# Set FREE_ACCESS_ENABLED=true and an ISO end date, then redeploy.
FREE_ACCESS_ENABLED=
FREE_ACCESS_UNTIL=

# Protect cron endpoints (e.g. Supabase keepalive)
CRON_SECRET=

# Lemon Squeezy billing (paid routes / webhook)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID_MONTHLY=
LEMON_SQUEEZY_VARIANT_ID_ANNUAL=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Billing mode: explicit "true"/"false" recommended in production (see lib/billing/test-mode.ts)
# Unset defaults to live mode in production, test mode in development.
LEMON_SQUEEZY_TEST_MODE=

# Contact form — messages sent via Resend to this inbox
RESEND_API_KEY=
CONTACT_EMAIL_TO=robertdavidcashman@gmail.com

# Editorial audit daily digest (cron: /api/cron/editorial-audit at 07:00 UTC)
# AUDIT_EMAIL_TO=          — defaults to CONTACT_EMAIL_TO
# AUDIT_EMAIL_ON_CLEAN=false — set to false to skip email when a run finds zero issues

# Newsletter / lead-magnet capture (app/api/newsletter). Optional.
# If RESEND_AUDIENCE_ID is set, subscribers are added to that Resend audience;
# otherwise a notification email is sent to CONTACT_EMAIL_TO. Missing config
# fails safe (the form still returns success).
RESEND_AUDIENCE_ID=

# --- Buffer social scheduling (app/api/buffer/schedule) — server-side only ---
# Personal Access Token: Buffer → Settings → API → Personal Keys
BUFFER_ACCESS_TOKEN=
# Or legacy: BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
# Add only the channels you want to post to (each enables that platform).
BUFFER_CHANNEL_LINKEDIN_ID=
BUFFER_CHANNEL_FACEBOOK_ID=
BUFFER_CHANNEL_TWITTER_ID=
BUFFER_CHANNEL_GOOGLEBUSINESS_ID=
# Days ahead to scan Buffer's queue for dedup (default 30).
BUFFER_DEDUP_WINDOW_DAYS=30
# Trigger: GET /api/buffer/schedule  (Bearer ${CRON_SECRET})
#   ?dryRun=1                 plan + dedup only (no writes)
#   ?slug=<post-slug>         schedule ONE post (the required test post)
#   ?limit=N                  cap number of source posts

# AI features (optional)
OPENAI_API_KEY=

# Playwright E2E sign-in flows (tests/e2e/auth-flow.spec.ts) — never commit real credentials
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=

# Legacy alias for tests/e2e/login-real.spec.ts (same values as E2E_* work too)
# QA_EMAIL=
# QA_PASSWORD=
